{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": { "include": ["**"], "exclude": ["README.md", "cdk*.json", "node_modules", "test"] },
  "context": {
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "environments": {
      "dev": {
        "account": "111111111111",
        "region": "us-east-1",
        "vpcCidr": "10.21.0.0/16",
        "maxAzs": 2,
        "natGateways": 1,
        "enableInterfaceEndpoints": false,
        "logRetentionDays": 14
      },
      "prod": {
        "account": "222222222222",
        "region": "us-east-1",
        "vpcCidr": "10.31.0.0/16",
        "maxAzs": 3,
        "natGateways": 3,
        "enableInterfaceEndpoints": true,
        "logRetentionDays": 90
      }
    },
    "projectName": "agentes-devops",
    "githubRepository": "seu-usuario/agentes-devops-iac"
  }
}
